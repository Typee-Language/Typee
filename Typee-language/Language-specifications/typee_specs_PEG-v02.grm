#####   CODE MODULE   #################################################

TCodeModule <- StatementsList* ENDMARKER

ENDMARKER  <- !.



#####   CLASSES   ####################################################

ClassDefinition     <- CLASS_TK  Identifier  TemplateDef?  Inheritance?  StatementsBlock


CLASS_TK            <- "class"


Inheritance         <- ':'  InterfaceItem   (','  InterfaceItem)*  (','  InheritanceItem  (',' InterfaceItem)*)?
                     / ':'  InheritanceItem   (',' InterfaceItem)*


InheritanceItem     <- AccessQualifier?  DottedName  TemplateArgs?


InterfaceItem       <- "implements"  AccessQualifier?  DottedName  TemplateArgs?
                     / "implements"  '(' AccessQualifier?  DottedName  TemplateArgs?  (','  AccessQualifier?  DottedName  TemplateArgs?)*  ')'



#####   COMPREHENSIONS   #############################################

ForComprehension    <- "for"  '('  TargetList  "in"  CompTest  IterComprehension?  ')'


IfComprehension     <- "if"  '('  ConditionOrUnnamedFunc  ')'  IterComprehension?


IterComprehension   <- ForComprehension
                     / IfComprehension



#####   CONDITIONS   #################################################

Condition           <- CompTest  ("if"  CompTest  "else"  Expression)



#####   COMPARISONS   ################################################

Comparison          <- BitorExpr  (CompOperator  BitorEpxr)*            ## NOTE see LL1-v10 for spec of templated comparison operators


CompOperator        <- "<=>"
                     / "<="
                     / "<"
                     / "=="
                     / "!="
                     / ">="
                     / ">"
                     / "in"
                     / "is" "not"?
                     / "not" "in"


AndTest             <- NotTest ("and"  NotTest)?

NotTest             <- "not"?  Comparison

CompTest            <- AndTest  ("or" AndTest)                              ## NOTE CompTest here is a renaming of "OrTest" from LL1-v10



#####   EXPRESSIONS   ################################################

Expression              <- Condition
                        / UnnamedFunction


ArithmeticExpr          <- Term  (OpAdd TemplateArgs? Term)*                ## NOTE for a first implementation Templated operators should be abandonned


BitAndExpr              <- ShiftedExpr  ('&'  TemplateArgs?  ShiftedExpr)*  ## NOTE for a first implementation Templated operators should be abandonned

BitOrExpr               <- BitXorExpr  ('|'  TemplateArgs?  BitXorExpr)*    ## NOTE for a first implementation Templated operators should be abandonned

BitXorExpr              <- BitAndExpr  ('^'  TemplateArgs?  BitAndExpr)*    ## NOTE for a first implementation Templated operators should be abandonned


ExprList                <- Expression  (',' Expression)*


Factor                  <- AtomElement  (OpPower TemplateArgs?  UnaryExpr)* ## NOTE for a first implementation Templated operators should be abandonned
                                                                            ## NOTE could AtomElement be preceeded by a unary operator?
FactorsSeq              <- (OpMul  TemplateArgs?  Factor)*                  ## NOTE for a first implementation Templated operators should be abandonned


FileExpression          <- DottedName  FunctionCall*                        ## NOTE DottedName is either the identifier of a file or the identifier of a method of a file (in which case a function call is mandatory)


MapForm                 <- ':'  Expression  MapListOrComprehension

MapItem                 <- Expression  ':'  Expression

MapList                 <- (','  MapItem)*

MapListOrComprehension  <- (','  MapItem)+
                         / ForComprehension                                 ## NOTE mandatory pairing syntax might be specified here - complex?


ParenthesisedExpr       <- '('  Expression  ')'


ShiftedExpr             <- ArithmeticExpr  ShiftExpr*

ShiftExpr               <- "<<<"  SpacedTemplateArgs?  ArithmeticExpr       ## NOTE for a first implementation Templated operators should be abandonned
                         / "<<"   SpacedTemplateArgs?  ArithmeticExpr
                         / ">>>"  TemplateArgs?  ArithmeticExpr
                         / ">>"   TemplateArgs?  ArithmeticExpr


Term                    <- Factor  FactorsSeq*


UnaryExpr               <- '+'  Factor
                         / '-'  Factor
                         / '~'  Factor
                         / '#'  Factor                                      ## NOTE maybe suppressed in first released version of grammar specs
                         / Factor



#####   FUNCTIONS   ##################################################

FunctionDeclaration         <- Type  Identifier  TemplateDef?  FunctionParamsDeclaration  ExcludeStatement?


FunctionDefinition          <- FunctionDeclaration  StatementsBlock


CallOperator                <- '('  Spacing*  ')'


FunctionParamsDeclaration   <- '('  TypedParamsList*  ')'


FunctionCall                <- TemplateArgs*  '('  FunctionCallArgs?  ')'

FunctionCallArgs            <- Expression  FunctionCallArgsList*

FunctionCallArgsList        <- (',' Expression)*  (','  Ellipsis  Identifier)?
                             / ForComprehension


TypedParamsList             <- Type Identifier (','  Type Identifier)*


Unnamed                     <- "unnamed"
                             / "lambda"


UnnamedFunc                 <- Unnamed  Type?  FunctionParamsDeclaration  StatementBlock



#####   MISC   #######################################################

COMMA                   <- ';'

ENDOFLINE               <- "\r\n"
                         / '\n'             ## NOTE 0x0a
                         / '\r'             ## NOTE 0x0d
                         / '\v'             ## NOTE 0x0b
                         / '\f'             ## NOTE 0x0c


DottedName              <- Identifier  ('.'  Identifier)*


Identifier              <- (AlphaChar / '_')  (AlphaNumChar / '_')*


Spacing                 <- ' '
                         / '\t'
                         / ENDOFLINE



#####   OPERATORS   ##################################################

OpAdd                   <- '+'
                         / '-'
                         
OpMul                   <- '*'
                         / '/'
                         / '%'

OpPower                 <- '**'
                         / '^^' 

OpUser                  <- "@@"
                         / "><"
                         / "<>"
                         / "!!"
                         / "::"
                         / "??"
                         / "##"                                         ## NOTE added


Operator                <- AssignOp
                         / CastOp
                         / "++"
                         / "--"
                         / OpAdd
                         / OpPower
                         / OpMul
                         / OpUser
                         / "<="
                         / ">="
                         / "=="
                         / "!="
                         / '&'
                         / '|'
                         / '^'
                         / '@'
                         / '#'
                         / "in"

OperatorAngle           <- ">>>"
                         / ">>"
                         / '>'
                         / "<<<"
                         / "<<"
                         / '<'

AssignOp                <- '='
                         / AugmentedAssignOp

AugmentedAssignOp       <- "+="                                         ## NOTE templated augmented assignement operator should be specified
                         / "-="                                         ## NOTE one way to achieve this: specify a rule with '=' succeeding 
                         / "**="                                        ## NOTE the templated operator definition with NO spacing
                         / "*="                                         ## NOTE Caution: not all operators are elligible for augmentation
                         / "/="                                         ## NOTE for instance: comparison operators
                         / "%="
                         / "&="
                         / "|="
                         / "^^="
                         / "^="
                         / "@@="
                         / "@="
                         / "<<<="
                         / "<<="
                         / "<>="
                         / ">>>="
                         / ">>="
                         / "><="
                         / "<>="
                         / "!!="
                         / "::="
                         / "??="
                         / "##="


OperatorCallDef         <- CallOperator  TemplateDef?

OperatorDeclaration     <- "operator"  OperatorSubdef

OperatorDefinition      <- OperatorDeclaration  StatementsBlock

OperatorSubdef          <- OperatorTemplatedDef  FunctionParamsDeclaration
                         / OperatorCallDef

OperatorTemplatedDef    <- Operator TemplatedDef?
                         / OperatorAngle  SpacedTemplateArgs?
                         
                         

#####   STATEMENTS   #################################################

StatementsList          <- EmptyStatement                               ##-- OK All checked --
                         / StatementsBlock Spacing*


StatementsBlock         <- '{'  StatementsList*  '}'                    ##-- OK All checked --
                         / SimpleStatement Spacing* SimpleStatementEnd Spacing*
                         / CompoundStatement Spacing*


EmptyStatement          <- Comment                                      ##-- OK All checked --
                         / Spacing+


SimpleStatement         <- AssertStatement                              ##-- OK All checked --
                         / DelStatement
                         / EnsureStatement
                         / FileEndianness
                         / FileFlushing
                         / FlowStatement
                         / ImportStatement
                         / NopStatement
                         / AccessProtectionStatement
                         / RaiseStatement
                         / RequireStatement


SimpleStatementEnd      <- COMMA                                        ##-- OK All checked --


CompoundStatement       <- DeclarationStatement  SimpleStatementEnd     ## NOTE may not be allowed everywhere
                         / DefinitionStatement                          ## NOTE may not be allowed everywhere
                         / DottedName  FunctionCall  SimpleStatementEnd
                         / DottedName  TargetList  AssignmentStatement  SimpleStatementEnd
                         / EmbedStatement
                         / ExcludeStatement                             ## NOTE may not be allowed everywhere
                         / ForStatement
                         / ForeverStatement
                         / IfStatement
                         / RepeatStatement
                         / SwitchStatement
                         / TryStatement
                         / WhileStatement
                         / WithStatement


AssertStatement         <- "assert"  Condition  (',' String)?           


AssignmentStatement     <- AssignOp  ExprList


Comment                 <- "//"  (!ENDOFLINE .)*
                         / MultiLinesComment

MultiLinesComment       <- "/*"  (MultiLinesComment  /  !"*/" .)*  "*/"



#####################################################################################################################
DeclarationStatement    <- Forward  AccessQualifier  StaticQualifier  ForwardDeclaration
                         / Forward  AccessQualifier  ForwardDeclaration
                         / Forward  StaticQualifier  ForwardDeclaration
                         / Forward  ForwardDeclaration
                         / AccessQualifier  StaticQualifier  Declaration
                         / AccessQualifier  Declaration
                         / StaticQualifier  Declaration
                         / Declaration


Declaration             <- MethodConstDeclaration                          
                         / FunctionDeclaration
                         / VariablesDeclaration
                         / VolatilesDeclaration


Forward                 <- "forward"
                         / "fwd"

ForwardDeclaration      <- VolatileQualifier    VolatileItem  (','  VolatileItem)*
                         / TypeDeclaration
                         / ClassDeclaration
                         / PropertyDeclaration
                         / MethodConstDeclaration
                         / FunctionDeclaration
                         / OperatorDeclaration
                         / Type  Identifier  (',' Identifier)*
                         / Type  OperatorDeclaration


FunctionDeclaration     <- Type  Identifier  FunctionParamsDeclaration


VariablesDeclaration    <- Type  VariablesDeclList

VariablesDeclList       <- VariableDecl  (','  VariableDecl)*  SimpleStatementEnd

VariableDecl            <- Identifier  ('=' Expression)?


VolatilesDeclaration    <- VolatileQualifier  NotConstType  Identifier  (','  Idengtifier)*  SimpleStatementEnd


ClassDeclaration        <- CLASS_TK  Identifier  TemplateDef?  Inheritance?

MethodConstDeclaration  <- FunctionDeclaration  ConstQualifier          ## NOTE ending const qualifier is only authorized for class methods

PropertyDeclaration     <- PropertyQualifier    Type  Identifier

TypeDeclaration         <- TYPE_TK   Identifier



DefinitionStatement     <- ClassDefinition
                         / StaticQualifier?   Definition

Definition              <- AbstractQualifier  MethodDefinition          ## NOTE MethodDefinition must be defined
                         / AbstractQualifier  OperatorDefinition
                         / FinalQualifier     MethodDefinition
                         / FinalQualifier     OperatorDefinition
                         / MethodDefinition
                         / OperatorDefinition
                         / PropertyDeclaration  '='  StatementsBlock    ## NOTE '=' may be suppressed from the rule spec
                         / TypeAlias          SimpleStatementEnd
                         / EnumDefinition
                         / Type  Identifier  FunctionDefinition
                         / Type  OperatorDefinition  

VolatilesDefinition     <- VolatileQualifier  NotConstType  Identifier  MemoryAddress  (','  Identifier  MemoryAddress)*  SimpleStatementEnd

MemoryAddress           <- '@'  IntegerNumber





<decl constructor or decl end>  ::= ( '.' <identifier> )* 
                                        <decl or def statement'''>  |
                                    <function definition'>

<decl or def statement'>    ::= <abstract or final qualif> 
                                    <method or operator definition>  |
                                <volatile qualifier> <type> <identifier> 
                                    [<memory address>] <simple statement end> |
                                <property qualifier> <type> <identifier>
                                    '=' <statements block>  |
                                <type alias> <simple statement end>  |
                                <decl or def statement''>

<decl or def statement''>   ::= <TYPE'> <decl or def statement'''>  | 
                                <enum definition>  |
                                <identifier> <decl constructor or decl end>

<decl or def statement'''>  ::= <identifier> <decl or def statement''''>  |
                                <operator definition>

<decl or def statement''''> ::= <function definition>  |  
                                [<var declaration or assignment>] ';' 

<declaration statement>     ::= ',' <identifier> ['=' <expression>] 
                                    ( ',' <identifier> [ '=' <expression> ] )*




#####################################################################################################################


DelStatement            <- "del"  IdentifiersList


EnsureStatement         <- "ensure"  condition  (',' string)?


FileEndianness          <- '<'  FileExpression  FileRWOperation*
                         / '>'  FileExpression  FileRWOperation*


FileRWOperation         <- "<<<"  (Expression / '!')
                           "<<"   (Expression / '!') 
                           ">>>"  (Expression) 
                           ">>"   (Expression)


FileFlushing            <- '!'  FileExpression  FileFlushingOperation

FileFlushingOperation   <- '[' Expression  ']'  '='  Expression
                         / ( '<<<' Expression
                            / '<<' Expression )*


FlowStatement           <- "break"
                         / "continue"
                         / RaiseStatement
                         / ReturnStatement


IdentifiersList         <- DottedName  (',' DottedName)*


ImportStatement         <- ImportName
                        / ImportFrom

ImportName              <- "import"  ImportAsNames

ImportAsNames           <- ImportAsName  (',' ImportAsName)*
ImportAsName            <- DottedName  ("as" Identifier)?

ImportFrom              <- "from"  '.'*  DottedName  "import"  ImportFromList
ImportFromList          <- "all"  ImportBut
                         / '('  ImportAsNames  ')'                      ## NOTE could be finally removed from specs
                         / ImportAsNames

ImportBut               <- "but"  DottedName  (','  DottedName)*


NopStatement            <- "nop"                                        ## NOTE one single definition could be specified in final specs
                         / "pass"
                         / "NOP"


RaiseStatement          <- "raise"  Expression  ("from"  Expression)?


ReturnStatement         <- "return"  ExprList?
                         / "ret"  ExprList?                             ## CHK do we keep this alternative?


RequireStatement        <- "require"  Condition  (',' String)?


AccessProtectionStatement   <- ':'?  AccessQualifiers  ':'

AccessQualifiers        <- "hidden" Spacing+                            ## NOTE hidden could be removed and local retained in final specs
                         / "local" Spacing+
                         / "private" Spacing+
                         / "protected" Spacing+
                         / "public" Spacing+


EmbedStatement          <- "embed"  Language  EmbeddedCode

EmbeddedCode            <- DottedName  SimpleStatementEnd
                         / "{{"  (!"}}" .)  "}}"  Spacing*  ("exit"  SimpleStatementEnd)?


ExcludeStatement        <- "exclude"  Languages

Languages               <- Language  (','  Language)*

Language                <- "android"  LanguageVersion?                  ## NOTE should be replaced with kotlin
                         / "cpp"  LanguageVersion?                       ## ADD other targeted languages (e.g. typescript rather than javascript, Kotlin, c, ...
                         / "csharp"
                         / "c"  LanguageVersion?                         ## ADD standard version (as optionnal)
                         / "fortran"  LanguageVersion?
                         / "java"
                         / "kotlin"
                         / "python"  LanguageVersion?
                         / "py"  LanguageVersion?                        ## CHK maybe multiple naming for a same language should be avoided
                         / "rust"
                         / "typescript"

LanguageVersion         <- IntegerNumber  ('.'  [09]+)*


ForStatement            <- "for"  '('  TargetList  "in"  ExprList  ')'  StatementsList  ("otherwise" StatementsList)?   ## ok, but TargetList must be checked again


ForeverStatement        <- "forever"  '('  ')'  StatementsList


IfStatement             <- "if"  '('  Condition  ')'  StatementsList  (ElseIf  '('  Condition  ')'  StatementsList)*  (("else" / "otherwise")  StatementsList)?

ElseIf                  <- "elseif"
                         / "elif"
                         / "elsif"


RepeatStatement         <- "repeat"  StatementsList  "until"  '('  Condition  ')'  SimpleStatementEnd


SwitchStatement         <- "switch"  '('  Expression  ')'  SwitchBlock  ("otherwise"  ':'  StatementsList)?

SwitchBlock             <- '{'  CaseStatement*  '}'

CaseStatement           <- "case"  ExprList  ':'  StatementsList*  ("break" Spacing* SimpleStatementEnd)?


TryStatement            <- "try"  '{'  StatementsList*  '}'  TryStatementExcept  TryStatementOtherwise?  TryStatementFinally?
                         / "try"  '{'  StatementsList*  '}'  TryStatementFinally

TryStatementExcept      <- TryExcept  '{'  StatementsList*  '}'

TryExcept               <- "except"  '('  Expression  ("as"  Identifier)?  (',' Expression ("as" Identifier)?)*  ')'
                         / "except"  "all"  ("as"  Identifier)?

TryStatementOtherwise   <- "otherwise"  ('('  "Exception"  "as"  Identifier  ')')*  '{'  StatementsList*  '}'

TryStatementFinally     <- "finally"  '{'  StatementsList*  '}'

                             
WhileStatement          <- "while"  '('  Condition  ')'  StatementsList  ("otherwise" StatementsList)?


WithStatement           <- "with"  '('  WithItem  (',' WithItem)*  ')'  StatementsList

WithItem                <- Expression  ("as" TypedTarget)                       ## NOTE initally was `Expression  ("as"  SimpleType?  Target)`


Target                  <- DottedName  SubscriptionOrSlicing*

TypedTarget             <- SimpleType  Target
                         / TemplatedType  Target 
                         / DottedName  Target                                   ## NOTE DottedName is a type name
                         / Target                                               ## NOTE DottedName is an identifier of a variable for which type is known

TargetList              <- TypedTarget  (',' TypedTarget)*


CastOp                  <- "cast"  Identifier


EnumDeclaration         <- "enum"  Identifier

EnumDefinition          <-  EnumDeclaration '{'  EnumItem  (',' EnumItem)*  '}'

EnumExpression          <- IntegerNumber
                         / Identifier  '+'  IntegerNumber               ## NOTE identifer must be a known enum value identifier

EnumItem                <- Identifier  '+='  IntegerNumber              ## NOTE adds the integer number to the previous enum value
                         / Identifier  '='  EnumExpression
                         / Identifier


TypeAlias               <- TYPE_TK  Type  "as"  Identifier  (','  Type  "as"  Identifier)*



#####   STRINGS   ####################################################

String              <- StringLiteral+  ('.'  Identifier  FunctionCall)*
                     / StringInstance  ('.'  Identifier  FunctionCall)*


StringInstance      <- DottedName
                     / StringType  '('  (StringLiteral / StringInstance)  ('.'  Identifier  FunctionCall)*  ')'  ('.'  Identifier  FunctionCall)*
                     / StringType  '('  ')'  ('.'  Identifier  FunctionCall)*
                     
                     
StringLiteral       <- "'"  (AnyEscapedChar / AnyStringQuoteChar)* "'"
                     / '"'  (AnyEscapedChar / AnyStringQuoteChar)* '"'



#####   TEMPLATES   ##################################################

SpacedTemplateArgs  <- Spacing+  TemplateArgs


SpacedTemplateDef   <- Spacing+  TemplateDef


TemplateArgs        <- '<'  ( Condition  (',' Condition)* )?  '>'


TemplateDefs        <- '<'  TemplateSubDef  (',' TempalteSubDef)*  '>'

TempalteSubDef      <- Identifier
                     / ConstQualifier  ScalarTypeOrDottedName  Identifier  ('=' Expression)?



#####   TYPES   #################################################

Type                        <- ConstQualifier? SimpleType
                             / ConstQualifier? TemplatedType
                             / None

SimpleType                  <-  AutoType
                             / '(' TypesList ')'
                             / ContainerType
                             / EnumType
                             / FileType
                             / ScalarType FixedDimensions?
                           

NotConstType                <- SimpleType
                             / TemplatedType
                             / None


TemplatedType               <- DottedName  ('<' TypesAndExprsList '>')?  FixedDimensions?


AutoType                    <- '?' ("in" '(' TypesList ')')?


ContainerType               <- ArrayType                        ## ADD VectorType
                             / ListType
                             / MapType
                             / SetType


EnumType                    <- "enum"


FileType                    <-  "file" ContainedType


FixedDimensions             <- ('[' (IntegerNumber / DottedName) ']')+


GenericContainerType        <- "_container_"


GenericScalarType           <- "_float_"
                             / "_int_"
                             / "_numeric_"
                             / "_scalar_"
                             / "_str_"
                             / "_uint_"


ScalarType                  <- "bool"
                             / "char16"
                             / "char"
                             / "float32"
                             / "float64"
                             / "int8"
                             / "int16"
                             / "int64"
                             / "int128"
                             / "slice"
                             / "uint8"
                             / "uint16"
                             / "uint32"
                             / "uint64"
                             / "uint128"
                             / "bigint"
                             / StringType
                             / GenericScalarType

StringType                  <- "str16"
                             / "str"


TYPE_TK                     <- "type"


TypesAndExprsList           <- (Expression / Type) (',' (Expression / Type))*


TypesList                   <- Type (',' Type)*


ArrayType                   <- "array" ContainedType

ListType                    <- "list" ContainedType?

MapType                     <- "map" MapContainedTypes

SetType                     <- "set" ContainedType?


ContainedType               <- '<' Type '>'

MapContainedType            <- '<' Type (',' Type)? '>'


AbstractQualifier           <- "abstract"

ConstQualifier              <- "const"

FinalQualifier              <- "final"

PropertyQualifier           <- "property"

StaticQualifier             <- "static"

VolatileQualifier           <- "volatile"



