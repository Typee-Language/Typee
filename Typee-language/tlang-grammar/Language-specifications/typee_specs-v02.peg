#####   CODE MODULE   #################################################

TCodeModule <- StatementsList*  ENDMARKER

ENDMARKER  <- !.



#####   ATOMS   ######################################################

AtomItem                <- Atom
                         / Identifier  AtomItem1?                       ## NOTE replaced 'DottedName' with new rule 'Identifier'
                         / '-'  Identifier  AtomItem2*                  ## NOTE replaced 'DottedName' with new rule 'Identifier'
                         / CONST_KW?  ScalarType  TypeCasting           ## NOTE TO BE CHECKED!!!  Is type casting ok here?!?

AtomItem1               <- OpDecr
                         / OpIncr
                         / ForComprehension
                         / ("??"  Expression)+
                         / IsInstanceOf                                 ## NOTE TO BE CHECKED!!!  Is it ok here?!? Maybe better placed in conditions
                         / AtomItem2*

AtomItem2               <- FunctionCall  (('.' Identifier)?  AtomItem2)*
                         / SubscriptionOrSlicing  (('.' Identifier)?  AtomItem2)*


Atom                    <- (OpDecr / OpIncr)  Identifier  (OpDecr / OpIncr)?    ## NOTE replaced 'DottedName' with new rule 'Identifier'
                         / '-'?  Scalar
                         / AtomEnclosure
                         / Reference
                         / String
                         / FALSE_KW
                         / TRUE_KW


AtomEnclosure           <- BracketForm
                         / ParenthesisForm


BracketForm             <- '['  Expression  (ListForm / MapForm)  ']'


IsInstanceOf            <- "->"  Spacing*  Identifier                   ## NOTE identifier must be the name of a class (replaces 'DottedName')
                        <- "isinstanceof"  Spacing+  Identifier         ## NOTE replaced 'DottedName' with new rule 'Identifier'


ListForm                <- '['  Expression  ( (',' Expression)+ / ForComprehension )?  ']'


MapForm                 <- ':'  Expression  MapListOrComprehension


ParenthesisForm         <- '('  ExprList  ')'


Reference               <- '@'  Identifer                              ## NOTE which one would better fit, @ or &?
                         / '&'  Identifier


SliceForm               <- Expression  ':'  Expression?  (':'  Expression?)?


SubscriptionOrSlicing   <- '['  SliceForm  (']' / ')')
                         / '['  Expression  ExprList*  ']'              ## NOTE do we allow expr-list here?
                         / '['  Expression  IfComprehension  ']'



#####   CLASSES   ####################################################

ClassDefinition     <- CLASS_KW  Identifier  TemplateDef?  Inheritance?  StatementsBlock


Inheritance         <- ':'  InterfaceItem  (','  InterfaceItem)*  (','  InheritanceItem  (',' InterfaceItem)*)?
                     / ':'  InheritanceItem  (',' InterfaceItem)*


InheritanceItem     <- AccessQualifier?  Identifier  TemplateArgs?      ## NOTE replaced 'DottedName' with new rule 'Identifier'


InterfaceItem       <- IMPLEMENTS_KW  AccessQualifier?  Identifier  TemplateArgs?
                     / IMPLEMENTS_KW  '('  AccessQualifier?  Identifier  TemplateArgs?  (','  AccessQualifier?  Identifier  TemplateArgs?)*  ')'
                        ## NOTE replaced 'DottedName' with new rule 'Identifier'


#####   COMPREHENSIONS   #############################################

ForComprehension    <- FOR_KW  '('  TargetList  IN_KW  CompTest  IterComprehension?  ')'


IfComprehension     <- IF_KW  '('  ConditionOrUnnamedFunc  ')'  IterComprehension?


IterComprehension   <- ForComprehension
                     / IfComprehension



#####   CONDITIONS   #################################################

Condition           <- CompTest  (IF_KW  '('  CompTest  ')'  ELSE_KW  Expression)?



#####   COMPARISONS   ################################################

Comparison          <- BitOrExpr  (CompOperator  BitorEpxr)*            ## NOTE see LL1-v10 for spec of templated comparison operators


CompOperator        <- "<=>"
                     / "<="
                     / '<'
                     / "=="
                     / "!="
                     / ">="
                     / '>'
                     / IN_KW
                     / IS_KW  NOT_KW?
                     / NOT_KW IN_KW


AndTest             <- NotTest (AND_KW  NotTest)?

NotTest             <- NOT_KW?  Comparison

CompTest            <- AndTest  (OR_KW  AndTest)                        ## NOTE CompTest here is a renaming of "OrTest" from LL1-v10



#####   EXPRESSIONS   ################################################

Expression             <- Comparison                                        ## NOTE was previously specified as 'Condition' (error?)
                        / UnnamedFunction


IndexingExpression      <- Expression                                       ## NOTE indexing expressions must be integer


ArithmeticExpr          <- Term  (OpAdd TemplateArgs?  Term)*                ## NOTE for a first implementation Templated operators should be abandonned


BitAndExpr              <- ShiftedExpr  ('&'  TemplateArgs?  ShiftedExpr)*  ## NOTE for a first implementation Templated operators should be abandonned

BitOrExpr               <- BitXorExpr  ('|'  TemplateArgs?  BitXorExpr)*    ## NOTE for a first implementation Templated operators should be abandonned

BitXorExpr              <- BitAndExpr  ('^'  TemplateArgs?  BitAndExpr)*    ## NOTE for a first implementation Templated operators should be abandonned


ExprList                <- Expression  (',' Expression)*


Factor                  <- AtomItem  (OpPower TemplateArgs?  UnaryExpr)*    ## NOTE for a first implementation Templated operators might be abandonned
                         / '('  Spacing*  Expression  Spacing*  ')'


FileExpression          <- Identifier  FunctionCall*                        ## NOTE Identifier is either the identifier of a file or the identifier of a method of a file (in which case a function call is mandatory)
                                                                            ## NOTE replaced 'DottedName' with new rule 'Identifier'
MapItem                 <- Expression  ':'  Expression

MapList                 <- (','  MapItem)*

MapListOrComprehension  <- (','  MapItem)+
                         / ForComprehension                                 ## NOTE mandatory pairing syntax might be specified here - complex?


ParenthesisedExpr       <- '('  Expression  ')'


ShiftedExpr             <- ArithmeticExpr  ShiftExpr*

ShiftExpr               <- "<<<"  SpacedTemplateArgs?  ArithmeticExpr       ## NOTE for a first implementation Templated operators should be delayed
                         / "<<"   SpacedTemplateArgs?  ArithmeticExpr
                         / ">>>"  TemplateArgs?  ArithmeticExpr
                         / ">>"   TemplateArgs?  ArithmeticExpr


Term                    <- Factor  (OpMul  TemplateArgs?  Factor)*          ## NOTE for a first implementation Templated operators should be abandonned


UnaryExpr               <- '+'  Factor
                         / '-'  Factor
                         / '~'  Factor
                         / '#'  Factor                                      ## NOTE maybe suppressed in first released version of grammar specs
                         / Factor



#####   FUNCTIONS   ##################################################

FunctionDeclaration         <- Type  Identifier  TemplateDef?  FunctionParamsDeclaration  ExcludeStatement?


FunctionDefinition          <- FunctionDeclaration  StatementsBlock


CallOperator                <- '('  Spacing*  ')'


FunctionParamsDeclaration   <- '('  TypedParamsList*  ')'


FunctionCall                <- TemplateArgs*  '('  FunctionCallArgs?  ')'  Spacing*

FunctionCallArgs            <- Expression  FunctionCallArgsList*

FunctionCallArgsList        <- (',' Expression)*  (','  ELLIPSIS_KW  Identifier)?
                             / ForComprehension


TypedParamsList             <- Type Identifier (','  Type Identifier)*


Unnamed                     <- UNNAMED_KW
                             / LAMBDA_KW


UnnamedFunc                 <- Unnamed  Type?  FunctionParamsDeclaration  StatementsBlock



#####   KEYWORDS   ###################################################

KeyWordEnd          <- !NameThenChar                                ## NOTE new: after full keyword detection none of these specified chars should appear

ABSTRACT_KW         <- "abstract"           KeyWordEnd  Spacing+

ALL_KW              <- "all"                KeyWordEnd  Spacing+

AND_KW              <- "and"                KeyWordEnd  Spacing+

ARRAY_KW            <- "array"              KeyWordEnd  Spacing*

AS_KW               <- "as"                 KeyWordEnd  Spacing+

ASSERT_KW           <- "assert"             KeyWordEnd  Spacing+

BREAK_KW            <- "break"              KeyWordEnd  Spacing*

BUT_KW              <- "but"                KeyWordEnd  Spacing+

CASE_KW             <- "case"               KeyWordEnd  Spacing+

CAST_KW             <- "cast"               KeyWordEnd  Spacing+

CLASS_KW            <- "class"              KeyWordEnd  Spacing+

CONST_KW            <- "const"              KeyWordEnd  Spacing+

CONTINUE_KW         <- "continue"           KeyWordEnd  Spacing*

DELETE_KW           <- "del"                KeyWordEnd  Spacing+

ELLIPSIS_KW         <- "..."                KeyWordEnd  Spacing*

ELSEIF_KW           <- ("elseif" / "elsif" / "elif")  KeyWordEnd  Spacing*

ELSE_KW             <- "else"               KeyWordEnd  Spacing*

EMBED_KW            <- "embed"              KeyWordEnd  Spacing+

ENSURE_KW           <- "ensure"             KeyWordEnd  Spacing+

ENUM_KW             <- "enum"               KeyWordEnd  Spacing*

EXCEPT_KW           <- "except"             KeyWordEnd  Spacing*

EXCEPTION_KW        <- "exception"          KeyWordEnd  Spacing*

EXCLUDE_KW          <- "exclude"            KeyWordEnd  Spacing+
   
EXIT_KW             <- "exit"               KeyWordEnd  Spacing*

FALSE_KW            <- ("false" / "False")  KeyWordEnd  Spacing*

FILE_KW             <- "file"               KeyWordEnd  Spacing+

FINAL_KW            <- "final"              KeyWordEnd  Spacing+

FINALLY_KW          <- "finally"            KeyWordEnd  Spacing*

FOR_KW              <- "for"                KeyWordEnd  Spacing*

FOREVER_KW          <- "forever"            KeyWordEnd  Spacing*

FORWARD_KW          <- ("forward" / "fwd")  KeyWordEnd  Spacing+                    ## CHK do we keep this alternative?

FROM_KW             <- "from"               KeyWordEnd  Spacing+

HIDDEN_KW           <- "hidden"             KeyWordEnd  Spacing*                    ## NOTE hidden could be removed and local retained in final specs

IF_KW               <- "if"                 KeyWordEnd  Spacing*

IMPLEMENTS_KW       <- "implements"         KeyWordEnd  Spacing+

IMPORT_KW           <- "import"             KeyWordEnd  Spacing+

IN_KW               <- "in"                 KeyWordEnd  Spacing*

IS_KW               <- "is"                 KeyWordEnd  Spacing+

LAMBDA_KW           <- "lambda"             KeyWordEnd  Spacing+

LIST_KW             <- "list"               KeyWordEnd  Spacing*

LOCAL_KW            <- "local"              KeyWordEnd  Spacing*                    ## NOTE hidden could be removed and local retained in final specs

MAP_KW              <- "map"                KeyWordEnd  Spacing*

ME_KW               <- "me"                 KeyWordEnd  Spacing*

NONE_KW             <- ("none" / "None" / "NONE")   KeyWordEnd  Spacing*            ## NOTE should we keep 'NONE'? (to conform with TRUE_KW and FALSE_KW definitions)

NOP_KW              <- ("nop" / "pass")     KeyWordEnd  Spacing*

NOT_KW              <- "not"                KeyWordEnd  Spacing*

OPERATOR_KW         <- "operator"           KeyWordEnd  Spacing*

OR_KW               <- "or"                 KeyWordEnd  Spacing*

OTHERWISE_KW        <- "otherwise"          KeyWordEnd  Spacing*

PRINT_KW            <- "print"              KeyWordEnd  Spacing*

PRIVATE_KW          <- "private"            KeyWordEnd  Spacing*

PROPERTY_KW         <- "property"           KeyWordEnd  Spacing+

PROTECTED_KW        <- "protected"          KeyWordEnd  Spacing*

PUBLIC_KW           <- "public"             KeyWordEnd  Spacing*

RAISE_KW            <- "raise"              KeyWordEnd  Spacing+

REPEAT_KW           <- "repeat"             KeyWordEnd  Spacing*

REQUIRE_KW          <- "require"            KeyWordEnd  Spacing+

RETURN_KW           <- ("return" / "ret")   KeyWordEnd  Spacing*                    ## CHK do we keep this alternative?

SET_KW              <- "set"                KeyWordEnd  Spacing*

STATIC_KW           <- "static"             KeyWordEnd  Spacing+

SWITCH_KW           <- "switch"             KeyWordEnd  Spacing*

TODO_KW             <- "todo"               KeyWordEnd  Spacing*

TRUE_KW             <- ("true" / "True")    KeyWordEnd  Spacing*

TRY_KW              <- "try"                KeyWordEnd  Spacing*

TYPE_KW             <- "type"               KeyWordEnd  Spacing+

UNNAMED_KW          <- "unnamed"            KeyWordEnd  Spacing*

UNTIL_KW            <- "until"              KeyWordEnd  Spacing*

VOLATILE_KW         <- "volatile"           KeyWordEnd  Spacing+

WHEN_KW             <- "when"               KeyWordEnd  Spacing*

WHILE_KW            <- "while"              KeyWordEnd  Spacing*

WITH_KW             <- "with"               KeyWordEnd  Spacing*



#####   MISCELANEOUS   ###############################################

AlphaChar               <- [A-Za-z]


AlphaNumChar            <- [0-9A-Za-z]


EndOfLine               <- "\r\n"
                         / '\n'                                         ## NOTE 0x0a
                         / '\r'                                         ## NOTE 0x0d


DottedName              <- Name  ('.'  Spacing*  Name)+                 ## NOTE new definition


Identifier              <- DottedName                                   ## NOTE new definition, former one is now named 'Name'
                         / Name                                         ## NOTE another possible definition is <- Name ('.' Spacing* Name)*


NameFirstChar           <- AlphaChar / '_'                              ## NOTE new

NameThenChar            <- AlphaNumChar / '_'                           ## NOTE new

Name                    <- NameFirstChar  NameThenChar*  Spacing*       ## NOTE new, renaming former 'Identifier'


SemiColon               <- ';'


Spacing                 <- ' '
                         / '\t'
                         / '\n'                                         ## NOTE 0x0a
                         / '\r'                                         ## NOTE 0x0d
                         / '\v'                                         ## NOTE 0x0b
                         / '\f'                                         ## NOTE 0x0c



#####   OPERATORS   ##################################################

OpAdd                   <- '+'
                         / '-'

OpDecr                  <- "--"

OpIncr                  <- "++"

OpMul                   <- '*'
                         / '/'
                         / '%'

OpPower                 <- '**'
                         / '^^' 

OpUser                  <- "@@"
                         / "><"
                         / "<>"
                         / "!!"
                         / "::"
                         / "??"
                         ##/ "##"                                         ## NOTE added, finally removed, see AugmentedAssignOp rule for comment


Operator                <- AssignOp
                         / CastOp
                         / OpDecr
                         / OpIncr
                         / OpAdd
                         / OpPower
                         / OpMul
                         / OpUser
                         / "<="
                         / ">="
                         / "=="
                         / "!="
                         / '&'
                         / '|'
                         / '^'
                         / '@'
                         / '#'
                         / IN_KW

OperatorAngle           <- ">>>"
                         / ">>"
                         / '>'
                         / "<<<"
                         / "<<"
                         / '<'

AssignOp                <- '='
                         / AugmentedAssignOp

AugmentedAssignOp       <- "+="                                         ## NOTE templated augmented assignement operator should be specified
                         / "-="                                         ##        one way to achieve this: specify a rule with '=' succeeding 
                         / "**="                                        ##        the templated operator definition with NO spacing.
                         / "*="                                         ##      Caution: not all operators are elligible for augmentation,
                         / "/="                                         ##        for instance: comparison operators
                         / "%="
                         / "&="
                         / "|="
                         / "^^="
                         / "^="
                         / "@@="
                         / "@="
                         / "<<<="
                         / "<<="
                         / "<>="
                         / ">>>="
                         / ">>="
                         / "><="
                         / "<>="
                         / "!!="
                         / "::="
                         / "??="
                         ##/ "##="                                      ## NOTE added, finally removed


OperatorCallDef         <- CallOperator  TemplateDef?

OperatorDeclaration     <- OPERATOR_KW  OperatorSubdef

OperatorDefinition      <- OperatorDeclaration  StatementsBlock

OperatorSubdef          <- OperatorTemplatedDef  FunctionParamsDeclaration
                         / OperatorCallDef

OperatorTemplatedDef    <- Operator TemplatedDef?
                         / OperatorAngle  SpacedTemplateArgs?
                         


#####   SCALARS   ####################################################

Scalar                  <- FloatNumber    Spacing*
                         / IntegerNumber  Spacing*
                         / ComplexNumber  Spacing*


FloatNumber             <- [1-9]  DecimalPart?  FractionPart  ExponentPart?
                         / '0'  FractionPart?  ExponentPart?


IntegerNumber           <- '0'  OctalNumber
                         / '0'  [bB]  BinaryNumber
                         / '0'  [xX]  HexadecimalNumber
                         / [1-9]  DecimalPart?
                         / '0'


BinaryNumber            <- [01]  ('_'?  [01]+)*


DecimalPart             <- [0-9]  ('_'?  [0-9]+)*

ExponentPart            <- [eE]  [+-]?  ([1-9]  DecimalPart?  /  '0')

FractionPart            <- '.'  DecimalPart?


HexadecimalNumber       <- HexDigit  ('_'?  HexDigit+)*

HexDigit                <- [09AFaf]


OctalNumber             <- [0-7]  ('_'?  [0-7]+ )*


ComplexNumber           <- COMPLEX_KW  Spacing*  '('  Spacing*  ComplexImPart  Spacing*  ')'  Spacing*
                         / COMPLEX_KW  Spacing*  '('  Spacing*  ComplexRePart  Spacing*  (','  Spacing*  ComplexImPart  Spacing*)?  ')'  Spacing*

ComplexImPart           <- FloatNumber 'i'
                         / IntegerNumber 'i'

ComplexRePart           <- FloatNumber
                         / IntegerNumber


#####   STATEMENTS   #################################################

Statement               <- StatementsBlock    Spacing*
                         / SimpleStatement    Spacing*
                         / CompoundStatement  Spacing*


StatementsBlock        <-  '{'  StatementsList  Spacing*  '}'  Spacing*


StatementsList          <- (Spacing*  Statement*)*


SimpleStatement         <- AccessProtectionStatement
                         / AssertStatement           SimpleStatementEnd
                         / Comment
                         / DeclarationStatement      SimpleStatementEnd     ## NOTE may not be allowed everywhere
                         / DeleteStatement           SimpleStatementEnd
                         / Identifier  FunctionCall  SimpleStatementEnd                     ## NOTE replaced 'DottedName' with new rule 'Identifier'
                         / Identifier  TargetList  AssignmentClause  SimpleStatementEnd     ## NOTE replaced 'DottedName' with new rule 'Identifier'
                         / EmptyStatement            SimpleStatementEnd*
                         / EnsureStatement           SimpleStatementEnd
                         / FileEndianness
                         / FileFlushing              SimpleStatementEnd
                         / FlowStatement             SimpleStatementEnd
                         / ImportStatement           SimpleStatementEnd
                         / NoOperationStatement      SimpleStatementEnd
                         / RaiseStatement            SimpleStatementEnd
                         / RequireStatement          SimpleStatementEnd


SimpleStatementEnd      <- Spacing*  SemiColon  Spacing*


CompoundStatement       <- DefinitionStatement                          ## NOTE may not be allowed everywhere
                         / EmbedStatement
                         / ForeverStatement
                         / ForStatement
                         / IfStatement
                         / RepeatStatement
                         / SwitchStatement
                         / TryStatement
                         / WhenStatement                                ## ADD
                         / WhileStatement
                         / WithStatement


AssertStatement         <- ASSERT_KW  Condition  (',' String)?  Spacing*


AssignmentClause        <- AssignOp  ExprList


Comment                 <- "//"  (!EndOfLine .)*  Spacing*
                         / MultiLinesComment  Spacing*

MultiLinesComment       <- "/*"  (MultiLinesComment  /  !"*/" .)*  "*/"


##DeclarationStatement    <- FORWARD_KW  AccessQualifier  STATIC_KW  ForwardDeclaration  Spacing*
##                         / FORWARD_KW  AccessQualifier  ForwardDeclaration  Spacing*
##                         / FORWARD_KW  STATIC_KW  ForwardDeclaration  Spacing*
##                         / FORWARD_KW  ForwardDeclaration  Spacing*
##                         / AccessQualifier  STATIC_KW  Declaration  Spacing*
##                         / AccessQualifier  Declaration  Spacing*
##                         / STATIC_KW  Declaration  Spacing*
##                         / Declaration  Spacing*
DeclarationStatement    <- FORWARD_KW  AccessQualifier?  STATIC_KW?  ForwardDeclaration  Spacing*
                         / AccessQualifier  STATIC_KW?  Declaration  Spacing*
                         / STATIC_KW?  Declaration  Spacing*


Declaration             <- MethodConstDeclaration
                         / ConstDeclaration
                         / FunctionDeclaration
                         / VariablesDeclaration
                         / VolatilesDeclaration


ForwardDeclaration      <- VOLATILE_KW  VolatileItem  (','  VolatileItem)*
                         / TypeDeclaration
                         / ClassDeclaration
                         / PropertyDeclaration
                         / MethodConstDeclaration
                         / FunctionDeclaration
                         / OperatorDeclaration
                         / Type  Identifier  (',' Identifier)*
                         / Type  OperatorDeclaration


FunctionDeclaration     <- CONST_KW  Type  Identifier  FunctionParamsDeclaration


ConstDeclaration        <- Type  Spacing*  Identifier  Spacing*  '='  Spacing*  Expression  Spacing*


VariablesDeclaration    <- Type  VariablesDeclList

VariablesDeclList       <- VariableDecl  (','  VariableDecl)*  SimpleStatementEnd

VariableDecl            <- Identifier  ('=' Expression)?


VolatilesDeclaration    <- VOLATILE_KW  NotConstType  Identifier  (','  Identifier)*  SimpleStatementEnd


ClassDeclaration        <- CLASS_KW  Identifier  TemplateDef?  Inheritance?

MethodConstDeclaration  <- FunctionDeclaration  CONST_KW          ## NOTE ending const qualifier is only authorized for class methods

PropertyDeclaration     <- PROPERTY_KW  Type  Identifier

TypeDeclaration         <- TYPE_KW  Identifier



DefinitionStatement     <- AccessQualifier  STATIC_KW?  Definition
                         / AccessQualifier?  ClassDefinition
                         / STATIC_KW?  Definition


Definition              <- ABSTRACT_KW  MethodDefinition
                         / ABSTRACT_KW  OperatorDefinition
                         / FINAL_KW  MethodDefinition
                         / FINAL_KW  OperatorDefinition
                         / MethodDefinition
                         / OperatorDefinition
                         / PropertyDeclaration  '='  DefintionBlock    ## NOTE '=' may be suppressed from the rule spec
                         / TypeAlias  SimpleStatementEnd
                         / EnumDefinition
                         / Type  Identifier  FunctionDefinition
                         / Type  OperatorDefinition
                         / VolatileDefinition


MethodDefinition        <- FunctionDeclaration  CONST_KW?  StatementsBlock      ## NOTE ending const qualifier is only authorized for class methods

VolatilesDefinition     <- VOLATILE_KW  NotConstType  Identifier  MemoryAddress  (','  Identifier  MemoryAddress)*  SimpleStatementEnd

MemoryAddress           <- '@'  IntegerNumber


DeleteStatement         <- DELETE_KW  IdentifiersList


EmptyStatement          <- Spacing*


EnsureStatement         <- ENSURE_KW  condition  (',' string)?


FileEndianness          <- '<'  FileExpression  FileRWOperation
                         / '>'  FileExpression  FileRWOperation


FileFlushing            <- '!'  FileExpression  FileWriteOperation?

FileReaOperation        <- ">>>"  (Expression) 
                         / ">>"   (Expression)

FileRWOperation         <- FileReadOperation
                         / FileWriteOperation 
                         
FileWriteOperation      <- '['  IndexingExpression  ']'  '='  Expression
                         / ( "<<<" Expression / "<<" Expression )*


FlowStatement           <- BREAK_KW
                         / CONTINUE_KW
                         / RaiseStatement
                         / ReturnStatement


IdentifiersList         <- Identifier  (',' Identifier)*            ## NOTE replaced 'DottedName' with new rule 'Identifier'


ImportStatement         <- ImportName
                         / ImportFrom

ImportName              <- IMPORT_KW  ImportAsNames

ImportAsNames           <- ImportAsName  (',' ImportAsName)*

ImportAsName            <- Identifier  (AS_KW Identifier)?          ## NOTE replaced 'DottedName' with new rule 'Identifier'

ImportFrom              <- FROM_KW  ModulePath  IMPORT_KW  ImportFromList

ImportFromList          <- ALL_KW  ImportBut
                         / ImportAsNames

ImportBut               <- BUT_KW  Identifier  (','  Identifier)*   ## NOTE replaced 'DottedName' with new rule 'Identifier'

ModulePath              <- '.'*  Identifier                         ## NOTE a module path should not contain the ".ty" suffix of its related filepath
                                                                    ## NOTE replaced 'DottedName' with new rule 'Identifier'


NoOperationStatement     <- NOP_KW  Spacing*


RaiseStatement          <- RAISE_KW  Expression  (FROM_KW  Expression)? ## NOTE not all expressions are vaild after "from" - only exception naming expressions are


ReturnStatement         <- RETURN_KW  ExprList?


RequireStatement        <- REQUIRE_KW  Condition  (',' String)?


AccessProtectionStatement   <- (':'  Spacing*)?  AccessQualifiers  ':'  Spacing*

AccessQualifiers        <- HIDDEN_KW                                ## NOTE hidden could be removed and local retained in final specs
                         / LOCAL_KW
                         / PRIVATE_KW
                         / PROTECTED_KW
                         / PUBLIC_KW


EmbedStatement          <- EMBED_KW  Language  Spacing*  EmbeddedCode

EmbeddedCode            <- FilePath  SimpleStatementEnd
                         / "{{"  (!"}}" .)  "}}"  Spacing*  (EXIT_KW  SimpleStatementEnd)?


ExcludeStatement        <- EXCLUDE_KW  Languages

FilePath                <- '.'*  Identifier                             ## NOTE a file path may be suffixed according to the targetted language conventions

Languages               <- Language  (','  Language)*

Language                <- "android"  LanguageVersion?                  ## NOTE should be replaced with kotlin
                         / "cpp"  LanguageVersion?                      ## ADD other targeted languages (e.g. typescript rather than javascript, Kotlin, c, ...
                         / "csharp"
                         / "c"  LanguageVersion?                        ## ADD standard version (as optionnal)
                         / "fortran"  LanguageVersion?
                         / "java"
                         / "kotlin"
                         / "python"  LanguageVersion?
                         / "py"  LanguageVersion?                       ## CHK maybe multiple naming for a same language should be avoided
                         / "rust"
                         / "typescript"

LanguageVersion         <- Spacing+  IntegerNumber  ('.'  [0-9]+)*


ForStatement            <- FOR_KW  '('  TargetList  IN_KW  ExprList  ')'  StatementsList  (OTHERWISE_KW  StatementsList)?


ForeverStatement        <- FOREVER_KW  '('  Spacing*  ')'  StatementsList


IfStatement             <- IF_KW  '('  Condition  ')'  StatementsList  (ELSEIF_KW  '('  Condition  ')'  StatementsList)*  ((ELSE_KW / OTHERWISE_KW)  StatementsList)?


RepeatStatement         <- REPEAT_KW  StatementsList  UNTIL_KW  '('  Condition  ')'  SimpleStatementEnd  (OTHERWISE_KW  StatementsList)?


SwitchStatement         <- SWITCH_KW  '('  Expression  ')'  SwitchBlock  (OTHERWISE_KW  ':'  StatementsList)?

SwitchBlock             <- '{'  CaseStatement*  '}'

CaseStatement           <- CASE_KW  ExprList  ':'  StatementsList*  (BREAK_KW SimpleStatementEnd)?


TryStatement            <- TRY_KW  '{'  StatementsList*  '}'  TryStatementExcept  TryStatementOtherwise?  TryStatementFinally?
                         / TRY_KW  '{'  StatementsList*  '}'  TryStatementFinally

TryStatementExcept      <- TryExcept  '{'  StatementsList*  '}'

TryExcept               <- EXCEPT_KW  Spacing*  '('  Expression  (AS_KW  Identifier)?  (',' Spacing* Expression (AS_KW Identifier)?)*  ')'
                         / EXCEPT_KW  Spacing+  ALL_KW  (AS_KW  Identifier)?

TryStatementOtherwise   <- OTHERWISE_KW  ('(' EXCEPTION_KW AS_KW Identifier ')')*  '{'  StatementsList*  '}'

TryStatementFinally     <- FINALLY_KW  '{'  StatementsList*  '}'


WhenStatement           <- WHEN_KW  Spacing*  '('  Spacing*  WhenWithItem  (',' WhenWithItem)*  Spacing*  ')'  Spacing*  '{'  WhenClause+  (Spacing* OTHERWISE_KW  StatementsList)?  Spacing*  '}'     ## ADD

WhenClause              <- Spacing*  Expression  Spacing*  ':'  Spacing*  StatementsList  Spacing*

WhenWithItem            <- Expression  (AS_KW TypedTarget)?

                             
WhileStatement          <- WHILE_KW  Spacing*  '('  Spacing*  Condition  Spacing*  ')'  Spacing*  StatementsList  (  Spacing*OTHERWISE_KW  Spacing*  StatementsList)?  Spacing*


WithStatement           <- WITH_KW  '('  WhenWithItem  (',' WhenWithItem)*  ')'  StatementsList


TypedTarget             <- SimpleType     Target
                         / TemplatedType  Target 
                         / Identifier     Target                        ## NOTE Identifier is a type name
                         / Target

Target                  <- Identifier  Spacing*  (SubscriptionOrSlicing+  Spacing*)?    ## NOTE replaced 'DottedName' with new rule 'Identifier'

TargetList              <- TypedTarget  (',' TypedTarget)*


CastOp                  <- CAST_KW  Identifier                          ## NOTE use of CastOp is still to be specified...


EnumDeclaration         <- ENUM_KW  Spacing*  Identifier

EnumDefinition          <-  EnumDeclaration  Spacing*  '{'  Spacing*  EnumItem  Spacing*  (','  Spacing*  EnumItem)*  Spacing*  '}'  Spacing* 

EnumExpression          <- IntegerNumber  '+'  Identifier
                         / IntegerNumber                                ## NOTE identifer must be a known enum value identifier
                         / Identifier  '+'  IntegerNumber               ## NOTE identifer must be a known enum value identifier

EnumItem                <- Identifier  '+='  IntegerNumber              ## NOTE adds the integer number to the previous enum value
                         / Identifier  '='  EnumExpression
                         / Identifier


TypeAlias               <- TYPE_KW  Type  Spacing+  AS_KW  Identifier  Spacing*  (','  Spacing*  Type  Spacing+  AS_KW  Identifier  Spacing*)*



#####   STRINGS   ####################################################

String              <- StringLiteral   ('.'  Identifier  FunctionCall)*
                     / StringInstance  ('.'  Identifier  FunctionCall)*


StringInstance      <- Identifier                                       ## NOTE replaced 'DottedName' with new rule 'Identifier'
                     / StringType  '('  (StringLiteral / StringInstance)  ('.'  Identifier  FunctionCall)*  ')'  ('.'  Identifier  FunctionCall)*
                     / StringType  '('  ')'  ('.'  Identifier  FunctionCall)*
                     
                     
StringLiteral       <- "'"  (!"'" .)* "'"
                     / '"'  (!'"' .)* '"'



#####   TEMPLATES   ##################################################

SpacedTemplateArgs  <- Spacing+  TemplateArgs


SpacedTemplateDef   <- Spacing+  TemplateDef


TemplateArgs        <- '<'  ( Condition  (',' Condition)* )?  '>'


TemplateDefs        <- '<'  TemplateSubDef  (',' TempalteSubDef)*  '>'

TempalteSubDef      <- Identifier
                     / CONST_KW  ScalarTypeOrIdentifier  Identifier  ('=' Expression)?



#####   TYPES   #################################################

Type                        <- CONST_KW? TemplatedType
                             / CONST_KW? SimpleType
                             / NONE_KW


SimpleType                  <-  AutoType
                             / '('  Spacing*  TypesList  ')'  Spacing*
                             / ContainerType
                             / ENUM_KW
                             / FileType
                             / ScalarType  FixedDimensions?
                           

NotConstType                <- TemplatedType
                             / SimpleType
                             / NONE_KW


TemplatedType               <- Identifier  ('<' Spacing* TypesAndExprsList Spacing* '>')?  FixedDimensions?


AutoType                    <- '?'  Spacing+  (IN_KW Spacing* '(' Spacing* TypesList ')')?  Spacing*


ContainerType               <- ArrayType
                             / ListType
                             / MapType
                             / SetType
                             / VectorType                       ## ADD to be defined!  ## NOTE may be suppressed, to be decided


FileType                    <-  FILE_KW  ContainedType


FixedDimensions             <- ( '[' Spacing* (IntegerNumber / Identifier) Spacing* ']' Spacing* )+


GenericContainerType        <- "_container_"


GenericScalarType           <- "_float_"
                             / "_int_"
                             / "_numeric_"
                             / "_scalar_"
                             / "_str_"
                             / "_uint_"


ScalarType                  <- "bigint"
                             / "bool"
                             / "char16"
                             / "char"
                             / "complex"
                             / "float32"
                             / "float64"
                             / "float128"
                             / "int8"
                             / "int16"
                             / "int64"
                             / "int128"
                             / "slice"
                             / "uint8"
                             / "uint16"
                             / "uint32"
                             / "uint64"
                             / "uint128"
                             / "bigint"
                             / StringType

ScalarTypeOrIdentifier      <- ScalarType                   ## NOTE added, was missing in previous version of grammar specs
                             / Identifier


StringType                  <- "str16"
                             / "str"


TypeCasting                 <- '('  ScalarType  ')'  Spacing*
                             / '('  Identifier  ')'  Spacing*       ## NOTE identifier must be an alias to a scalar type
                             

TypesAndExprsList           <- (Expression / Type)  Spacing*  (',' Spacing* (Expression / Type) Spacing*)*


TypesList                   <- Type  Spacing*  (',' Spacing* Type Spacing*)*


ArrayType                   <- ARRAY_KW  ContainedType

ListType                    <- LIST_KW  ContainedType?

MapType                     <- MAP_KW  MapContainedTypes

SetType                     <- SET_KW  ContainedType?


ContainedType               <- '<'  Spacing*  Type  Spacing*  '>'  Spacing*


MapContainedType            <- '<'  Spacing*  Type  Spacing*  ','  Spacing*  Type  Spacing*  '>'




